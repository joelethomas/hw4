# Copy to .env (here, in backend/, or in the parent "AI Foundations" folder) and fill in locally.
# Never submit the completed .env file.
PORTKEY_API_KEY=your_portkey_api_key_here
PORTKEY_BASE_URL=https://api.portkey.ai/v1
AGENT_MODEL=gpt-5.6-luna
AGENT_REASONING_EFFORT=low
# Optional: signing secret for login cookies (otherwise backend/.session_secret is generated)
# SESSION_SECRET=
# Optional overrides (used by tests/benchmarks):
# CAMPUS_CUSTOMS_DB=/path/to/copy.db
# CAMPUS_CUSTOMS_AUDIT=/path/to/audit_trail.json
# PORTKEY_FORCE_REFRESH=1
